<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Location of the locally generated regression fixture (tests skip when it is missing). -->
    <FixtureDir>$(MSBuildThisFileDirectory)..\fixtures\</FixtureDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmotePreviewer.Core\EmotePreviewer.Core.csproj" />
    <ProjectReference Include="..\EmotePreviewer.Fixtures\EmotePreviewer.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FixtureDir</_Parameter1>
      <_Parameter2>$(FixtureDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
